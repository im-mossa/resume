generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "catalog", "orders", "public", "utils"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model permissions {
  id               String             @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  name             String             @unique
  description      String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]

  @@schema("auth")
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  granted_at    DateTime    @default(now()) @db.Timestamptz(6)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
  @@schema("auth")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model roles {
  id               String             @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  name             String             @unique
  description      String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]
  user_roles       user_roles[]

  @@schema("auth")
}

model user_roles {
  user_id     String   @db.Uuid
  role_id     String   @db.Uuid
  assigned_at DateTime @default(now()) @db.Timestamptz(6)
  roles       roles    @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, role_id])
  @@schema("auth")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                    String                  @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  email                 String                  @unique
  password_hash         String
  first_name            String
  last_name             String
  phone                 String
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  is_active             Boolean                 @default(true)
  user_roles            user_roles[]
  product_price_history product_price_history[]
  orders                orders[]

  @@schema("auth")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model brands {
  id          String     @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  name        String     @unique
  description String?
  logo_url    String?
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  products    products[]

  @@schema("catalog")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model categories {
  id                 String               @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  name               String
  slug               String               @unique
  description        String?
  parent_id          String?              @db.Uuid
  is_active          Boolean              @default(true)
  sort_order         Int?                 @default(0)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  image_url          String?
  path               String?
  product_count      Int                  @default(0)
  categories         categories?          @relation("categoriesTocategories", fields: [parent_id], references: [id], onUpdate: NoAction)
  other_categories   categories[]         @relation("categoriesTocategories")
  product_categories product_categories[]
  products           products[]

  @@schema("catalog")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_reservations {
  id               String           @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  product_id       String           @db.Uuid
  variant_id       String           @db.Uuid
  quantity         Int
  status           String           @default("pending")
  reserved_by      String           @db.Uuid
  order_id         String           @db.Uuid
  expires_at       DateTime         @db.Timestamptz(6)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @default(now()) @db.Timestamptz(6)
  products         products         @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at])
  @@index([status])
  @@index([variant_id])
  @@schema("catalog")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product_images {
  id         String   @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  product_id String   @db.Uuid
  image_url  String
  alt_text   String?
  sort_order Int?     @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_images_product_id")
  @@schema("catalog")
}

model product_price_history {
  id           String   @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  source_table String   @default("products")
  product_id   String   @db.Uuid
  old_price    Decimal? @db.Decimal(12, 2)
  new_price    Decimal? @db.Decimal(12, 2)
  changed_by   String?  @db.Uuid
  changed_at   DateTime @default(now()) @db.Timestamptz(6)
  users        users?   @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products     products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([changed_at], map: "idx_pph_changed_at")
  @@index([product_id], map: "idx_pph_product_id")
  @@schema("catalog")
}

model product_tags {
  product_id String   @db.Uuid
  tag_id     String   @db.Uuid
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags       tags     @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, tag_id])
  @@schema("catalog")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product_variants {
  id                     String                   @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  product_id             String                   @db.Uuid
  sku                    String                   @unique(map: "unique_sku_global")
  color                  String?
  size                   String?
  stock                  Int?                     @default(0)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  inventory_reservations inventory_reservations[]
  products               products                 @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order_items            order_items[]

  @@index([product_id], map: "idx_product_variants_product_id")
  @@schema("catalog")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model products {
  id                     String                   @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  name                   String
  slug                   String                   @unique(map: "products_slug_unique")
  description            String?
  price                  Decimal                  @db.Decimal(12, 2)
  stock                  Int
  primary_category_id    String?                  @db.Uuid
  brand_id               String?                  @db.Uuid
  is_active              Boolean                  @default(true)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  inventory_reservations inventory_reservations[]
  product_categories     product_categories[]
  product_images         product_images[]
  product_price_history  product_price_history[]
  product_tags           product_tags[]
  product_variants       product_variants[]
  brands                 brands?                  @relation(fields: [brand_id], references: [id], onUpdate: NoAction)
  categories             categories?              @relation(fields: [primary_category_id], references: [id], onUpdate: NoAction, map: "products_category_id_fkey")
  order_items            order_items[]

  @@index([primary_category_id], map: "products_category_id_idx")
  @@schema("catalog")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tags {
  id           String         @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  name         String         @unique
  description  String?
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  product_tags product_tags[]

  @@schema("catalog")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  id               String           @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  order_id         String           @db.Uuid
  product_id       String           @db.Uuid
  variant_id       String           @db.Uuid
  quantity         Int
  unit_price       Decimal          @db.Decimal(12, 2)
  total_price      Decimal?         @default(dbgenerated("((quantity)::numeric * unit_price)")) @db.Decimal(12, 2)
  orders           orders           @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products         products         @relation(fields: [product_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  product_variants product_variants @relation(fields: [variant_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([order_id], map: "idx_order_items_order_id")
  @@index([variant_id], map: "idx_order_items_variant_id")
  @@schema("orders")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id               String        @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  user_id          String        @db.Uuid
  status           String
  total_amount     Decimal       @db.Decimal(12, 2)
  shipping_address String
  placed_at        DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime      @default(now()) @db.Timestamptz(6)
  order_items      order_items[]
  users            users         @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  payments         payments[]
  shipments        shipments[]

  @@index([placed_at])
  @@index([user_id])
  @@schema("orders")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id             String   @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  order_id       String   @db.Uuid
  method         String
  status         String
  transaction_id String   @unique
  paid_at        DateTime @db.Timestamptz(6)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  orders         orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id], map: "idx_payments_order_id")
  @@schema("orders")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model shipments {
  id              String    @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  order_id        String    @db.Uuid
  carrier         String?
  tracking_number String    @unique
  shipped_at      DateTime? @db.Timestamptz(6)
  delivered_at    DateTime? @db.Timestamptz(6)
  status          String
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  orders          orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("orders")
}

model product_categories {
  id          String     @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  product_id  String     @db.Uuid
  category_id String     @db.Uuid
  is_primary  Boolean    @default(false)
  position    Int        @default(0)
  metadata    Json?      @default("{}")
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  slug        String?
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pc_category")
  products    products   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pc_product")

  @@unique([product_id, category_id], map: "uq_product_category")
  @@index([category_id, position], map: "idx_pc_category_position")
  @@index([category_id, position, product_id], map: "idx_pc_category_position_prod")
  @@index([product_id], map: "idx_pc_product")
  @@schema("catalog")
}
